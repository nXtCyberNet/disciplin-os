<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="GPS ROUTES &amp; MAP"
                android:textColor="@color/hud_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/routes_txt_gps_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="🛰 GPS Fixed • Ready"
                android:textColor="@color/hud_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/routes_btn_external_map"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/hud_mission_button"
            android:fontFamily="sans-serif-medium"
            android:text="External Maps ↗"
            android:textColor="@color/hud_text_primary"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />
    </LinearLayout>

    <!-- Map View Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.mendhak.gpslogger.discipline.RouteMapView
            android:id="@+id/routes_map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Watermark / attribution -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="#AA000000"
            android:padding="4dp"
            android:fontFamily="sans-serif"
            android:text="therunplan.com • OpenStreetMap"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </FrameLayout>

</LinearLayout>
