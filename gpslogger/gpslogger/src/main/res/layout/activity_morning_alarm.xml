<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Top Status / Discipline Pill -->
    <LinearLayout
        android:id="@+id/alarm_pill_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:background="@drawable/alarm_pill_bg"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="⚡ DISCIPLINE MISSION ACTIVE"
            android:textColor="#22C55E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Center Clock and Motivation Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/alarm_actions_container"
        android:layout_below="@+id/alarm_pill_container"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alarm_txt_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/alarm_txt_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:text="06:00:00"
            android:textColor="#F8FAFC"
            android:textSize="54sp" />

        <TextView
            android:id="@+id/alarm_txt_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.12"
            android:text="AM"
            android:textColor="#22C55E"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/alarm_txt_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Today"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Mission Card in System Dark Surface Theme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/alarm_card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="🌅 MORNING RUN MISSION"
                android:textColor="#F8FAFC"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="&quot;Wake up. Put on your shoes. No excuses.&quot;"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/alarm_txt_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/alarm_tag_bg"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="🏃 Live GPS Route Tracking Active"
                android:textColor="#22C55E"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Buttons Container -->
    <LinearLayout
        android:id="@+id/alarm_actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:orientation="vertical">

        <!-- Primary Start Now Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/alarm_btn_start_run"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/alarm_btn_start"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="🏃 START NOW"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <!-- Secondary Snooze Button (15 Min) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/alarm_btn_snooze"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/alarm_btn_snooze"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04"
            android:text="💤 SNOOZE (15 MIN)"
            android:textColor="#F1F5F9"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:text="Starting run silences alarm and begins live GPS route tracking"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
