<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/hud_card_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Date & Verification Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_txt_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Nov 20, 2026 • 06:15 AM"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/item_txt_verified_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hud_pill_gps_ready"
            android:fontFamily="sans-serif-medium"
            android:text="✅ Verified"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Main Metrics Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTANCE"
                android:textColor="@color/hud_text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/item_txt_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="2.15 km"
                android:textColor="@color/hud_text_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Pace -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG PACE"
                android:textColor="@color/hud_text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/item_txt_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="5:05 /km"
                android:textColor="#10B981"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textColor="@color/hud_text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/item_txt_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="11:32"
                android:textColor="@color/hud_text_primary"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sub metrics: Steps, Cadence, Splits count -->
    <TextView
        android:id="@+id/item_txt_substats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="🎯 Target: 2.00 km @ &lt; 6:00 /km • 2,410 steps"
        android:textColor="@color/hud_text_secondary"
        android:textSize="11sp" />

</LinearLayout>
